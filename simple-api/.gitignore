# -------------------------------------------------------------------------
# Go Build Artifacts
# -------------------------------------------------------------------------
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with 'go test -c'
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Common local build binary names
/bin/
/dist/
/build/
main
server
app

# -------------------------------------------------------------------------
# Project Uploads & Static Assets
# -------------------------------------------------------------------------
# Ignore locally uploaded images, but keep the directory via .gitkeep
/uploads/*
!/uploads/.gitkeep

# -------------------------------------------------------------------------
# Databases & Local Data Stores
# -------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
shop.db

# -------------------------------------------------------------------------
# Environment & Secret Configurations
# -------------------------------------------------------------------------
*.env
*.env.local
*.env.*.local
!*.env.example

# -------------------------------------------------------------------------
# IDEs, Editors & OS Files
# -------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (GoLand, IntelliJ)
.idea/
*.iws
*.iml
*.ipr

# -------------------------------------------------------------------------
# Dependency / Vendor (optional: uncomment if NOT committing vendor/)
# -------------------------------------------------------------------------
# /vendor/

# Temporary / Log files
*.log
tmp/